    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
